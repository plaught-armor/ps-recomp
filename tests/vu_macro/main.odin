// VU0 macro code from the EE recompiler (recomp/vu.emit_macro) against the
// interpreter's vu_op. Two steps in one command: this program generates
// cases/main.odin, one proc per macro word emit_macro covers (fn and special
// 0x00-0x2f across dest masks, plus the lower ops it may cover: VMOVE,
// VMR32, VLQI, VSQI, VLQD, VSQD, VDIV, VSQRT, VRSQRT, VWAITQ, VMTIR, VMFIR
// and the integer ops, with fd 0, fs/ft 0, aliased and >15 registers, 16
// among them), then runs it with
// `odin run`. Each case runs from random VU0 state (special floats, preset
// sticky status bits, random MAC, clip and vi) and random VU0 data memory,
// and must leave the whole VU0 state and data memory as vu_op leaves them.
// The seed is fixed, so a run is reproducible. Words emit_macro leaves to
// the interpreter are counted and skipped. cases/ is generated, not checked
// in.
//
//   odin run tests/vu_macro -collection:ps=.
package main

import "core:fmt"
import "core:os"
import "core:strings"
import "ps:recomp/vu"

DIR :: #directory
CASES_DIR :: DIR + "/cases"

main :: proc() {
	sb := strings.builder_make()
	fmt.sbprintln(&sb, "// Generated by tests/vu_macro: do not edit.\npackage main\n")
	fmt.sbprintln(&sb, "import \"core:fmt\"\nimport \"core:math\"\nimport \"core:math/rand\"\nimport \"core:os\"\nimport \"core:simd\"\nimport \"core:slice\"\nimport vu \"ps:ps2/vu\"\n")
	fmt.sbprintln(&sb, "_ :: math\n_ :: simd\n")
	fmt.sbprintln(&sb, vu.VU_HELPERS)
	fmt.sbprintln(&sb, vu.MACRO_HELPERS)

	// dest also holds the lower ops' fsf (bits 21-22) and ftf (23-24): these
	// six masks give every value of both.
	DESTS := [?]u32{15, 14, 8, 1, 5, 0}
	REGS := [?][3]u32{{1, 2, 3}, {1, 2, 0}, {0, 2, 3}, {1, 0, 3}, {4, 4, 4}, {5, 6, 5}, {5, 6, 6}, {17, 18, 16}, {16, 16, 19}} // fs, ft, fd
	FN_LOWER := [?]u32{0x30, 0x31, 0x32, 0x34, 0x35} // VIADD, VISUB, VIADDI, VIAND, VIOR
	SP_LOWER := [?]u32{0x30, 0x31, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3a, 0x3b, 0x3c, 0x3d} // VMOVE, VMR32, VLQI, VSQI, VLQD, VSQD, VDIV, VSQRT, VRSQRT, VWAITQ, VMTIR, VMFIR
	words: [dynamic]u32
	for d in DESTS {
		for r in REGS {
			base := 0x4a000000 | d << 21 | r[1] << 16 | r[0] << 11
			for fn in u32(0) ..< 0x30 {append(&words, base | r[2] << 6 | fn)}
			for fn in FN_LOWER {append(&words, base | r[2] << 6 | fn)}
			for sp in u32(0) ..< 0x30 {append(&words, base | (sp >> 2) << 6 | 0x3c | (sp & 3))}
			for sp in SP_LOWER {append(&words, base | (sp >> 2) << 6 | 0x3c | (sp & 3))}
		}
	}

	n, skipped, empty := 0, 0, 0
	body := strings.builder_make()
	fmt.sbprintln(&sb, "CASES := [?]Case{")
	for w in words {
		code, ok := vu.emit_macro(w)
		if !ok {
			skipped += 1
			continue
		}
		if code == "" {empty += 1}
		fmt.sbprintfln(&body, "c_%d :: proc() {{%s}}", n, code)
		fmt.sbprintfln(&sb, "\t{{0x%08x, c_%d}},", w, n)
		n += 1
	}
	fmt.sbprintln(&sb, "}\n")
	fmt.sbprintln(&sb, strings.to_string(body))
	fmt.sbprint(&sb, HARNESS)

	dir :: CASES_DIR
	if !os.exists(dir) {
		if err := os.make_directory(dir); err != nil {fail("mkdir %s: %v", dir, err)}
	}
	path :: CASES_DIR + "/main.odin"
	if err := os.write_entire_file(path, sb.buf[:]); err != nil {fail("write %s: %v", path, err)}
	fmt.printfln("vu_macro: %d cases (%d empty), %d left to the interpreter", n, empty, skipped)

	// odin exits 0 on some build errors (an -out: without .exe on Windows), so a
	// missing binary afterwards fails the test. Remove any stale one first;
	// -keep-executable leaves the new one to check.
	out :: CASES_DIR + "/vu_macro_cases" + (".exe" when ODIN_OS == .Windows else "")
	_ = os.remove(out)
	p, err := os.process_start({command = {"odin", "run", dir, "-collection:ps=" + DIR + "/../..", "-out:" + out, "-keep-executable"}, stdout = os.stdout, stderr = os.stderr})
	if err != nil {fail("odin run: %v", err)}
	st, werr := os.process_wait(p)
	if werr != nil {fail("odin run: %v", werr)}
	if !st.success {fail("cases failed (exit %d)", st.exit_code)}
	if !os.exists(out) {fail("cases not built: %s", out)}
}

@(private = "file")
fail :: proc(what: string, args: ..any) -> ! {
	fmt.eprint("FAIL vu_macro: ")
	fmt.eprintfln(what, ..args)
	os.exit(1)
}

// The generated program's runner.
HARNESS :: `Case :: struct {w: u32, f: proc()}

SEED :: 0x5eed_0b16
TRIALS :: 300

SPECIAL := [?]u32{0, 0x80000000, 0x7f800000, 0xff800000, 0x7fffffff, 0xffffffff, 0x7fc00000, 0xffc00000, 0x7f7fffff, 0xff7fffff, 1, 0x80000001, 0x3f800000, 0xbf800000, 0x00800000, 0x007fffff, 0x807fffff}

rnd :: proc() -> u32 {
	switch rand.uint32() % 4 {
	case 0: return SPECIAL[rand.uint32() % len(SPECIAL)]
	case 1: return transmute(u32)(rand.float32_range(-4, 4))
	case 2: return transmute(u32)(f32(i32(rand.uint32() % 64) - 32)) // exact ints, zero results
	}
	return rand.uint32()
}

same :: proc(a, b: ^vu.Vu) -> bool {
	for k in 0 ..< 32 {if a.vf[k].u != b.vf[k].u {return false}}
	return a.vi == b.vi && a.acc.u == b.acc.u && transmute(u32)a.q == transmute(u32)b.q && transmute(u32)a.i == transmute(u32)b.i &&
		transmute(u32)a.p == transmute(u32)b.p && a.clip == b.clip && a.status == b.status && a.mac == b.mac
}

main :: proc() {
	rand.reset(SEED)
	vu.vu_init()
	// The data memory every trial starts from, and a case's result.
	mem := make([]u8, len(vu.vu0.mem))
	got_mem := make([]u8, len(mem))
	for k in 0 ..< len(mem) / 4 {(^u32)(&mem[k * 4])^ = rnd()}
	fails := 0
	for c in CASES {
		for _ in 0 ..< TRIALS {
			init := vu.vu0
			init.vf[0].f = {0, 0, 0, 1}
			for k in 1 ..< 32 {for l in 0 ..< 4 {init.vf[k].u[l] = rnd()}}
			for l in 0 ..< 4 {init.acc.u[l] = rnd()}
			init.vi[0] = 0
			for k in 1 ..< 16 {init.vi[k] = u16(rand.uint32())}
			init.q, init.i = transmute(f32)rnd(), transmute(f32)rnd()
			init.status = rand.uint32() & 0xfff // sticky bits preset at random
			init.mac, init.clip = rand.uint32() & 0xff, rand.uint32() & 0xffffff
			vu.vu0 = init
			copy(vu.vu0.mem, mem)
			c.f()
			got := vu.vu0
			copy(got_mem, vu.vu0.mem)
			vu.vu0 = init
			copy(vu.vu0.mem, mem)
			vu.vu_op(&vu.vu0, c.w)
			mem_ok := slice.equal(got_mem, vu.vu0.mem)
			if !same(&got, &vu.vu0) || !mem_ok {
				fails += 1
				if fails < 10 {
					fmt.eprintfln("FAIL vu_macro %08x: got mac %02x st %03x q %08x vf3 %08x vi3 %04x, want mac %02x st %03x q %08x vf3 %08x vi3 %04x, mem same %v",
						c.w, got.mac, got.status, transmute(u32)got.q, got.vf[3].u, got.vi[3],
						vu.vu0.mac, vu.vu0.status, transmute(u32)vu.vu0.q, vu.vu0.vf[3].u, vu.vu0.vi[3], mem_ok)
				}
				break
			}
			if got.vf[0].f != {0, 0, 0, 1} {
				fmt.eprintfln("FAIL vu_macro %08x: vf0 written", c.w)
				fails += 1
				break
			}
		}
	}
	fmt.printfln("vu_macro: %d cases x %d trials, %d failing", len(CASES), TRIALS, fails)
	if fails > 0 {os.exit(1)}
}
`
