// VU microprograms compiled whole by the VU recompiler (recomp/vu
// emit_micro) against the interpreter. Two steps in one command, as
// tests/vu_macro: this program generates cases/main.odin, one run_<n> per
// program and unit, then runs it with `odin run`. Each program runs from
// random state, once in the interpreter and once compiled, and must leave
// vf, vi, ACC, MAC, Q, P, the pending DIV's I and D bits (q_flags, q_due)
// and memory the same. Every program runs on VU1 and on VU0; status must
// match too on VU0, and on VU1 in a program that reads it (FSEQ, FSAND,
// FSOR), where compiled VU1 code computes it.
// The seed is fixed, so a run is reproducible. cases/ is generated, not
// checked in.
//
// The programs check MAC liveness: an op that leaves MAC alone (MAX, MINI)
// between a MAC write and a flag read must not let the write be dropped.
// Then hazard pairs, where the lower reads or writes the VF register the
// upper writes: the lower must read it from before the upper, and its own
// write must win unless it leaves the register as it was. The DIV
// programs pair DIV, SQRT and RSQRT with an upper op, so the two status
// writes merge, with divisors that set I or D on every trial. Two more let
// Q's wait reach four inside the stall of a DIV or a WAITQ after a DIV that
// sets D: the stalled pair takes the bits, so the end status keeps sticky D.
// Each runs on VU0, and on VU1 after an FSAND that makes compiled VU1 code
// compute status. Three more, on both units, let the bits fall due in a
// compiled pair between status reads. VU1 must set I or D as often as VU0.
// The VU0-only programs load and stores through VU0's window onto VU1's registers, at
// addresses with bit 0x400 set, from vi0 and from a vi; VU1 starts each
// VU0 trial from the same random registers and must end the same.
//
// Last, the EFU: each op writes P and MFP reads it back into part of a
// register, from random P first; then an ESIN reading and an MFP writing
// the upper's dest. Then ILWR and ISWR on each field, at addresses that
// wrap past the end of VU memory. Then a negative vi and a positive one
// through MFIR, IBLTZ and IBGEZ, each branch taken on one and not on the
// other. Every program must compile without a call into the interpreter,
// but for its status reads.
//
// After the trials, one VU1 program with no status read, registered alone,
// must make each outside read of VU1 status a compat row
// (vu_programs.stale_status).
//
// The clamp elision program is a chain of dependent ops on clamped
// results, with a loop whose branch target is in the middle, compiled twice:
// as a captured image entered at 0 and 0x48, which elides operand clamps and
// the case labels between and clamps the rest once per case body (vf4, read
// again after a MOVE over its clamped local, and vf10), and with every label
// and clamp. Each runs from both entries and must match the interpreter, so
// the two match each other; the second also from 0x50. The first,
// unlabelled at 0x08 and 0x50, must leave there at once for the
// interpreter, changing nothing; no trial runs from 0x08, which would skip
// setting the loop count. The pair at 0x38, the loop's delay slot, is a
// hazard: its MOVE reads the ADD's dest.
//
// The late-flag programs read MAC (FMAND) and clip (FCGET, FCAND) at each
// depth behind their writes, which a read sees four pairs late, and branch
// over a pair into that window, so the delay slot's shift alone carries the
// value the target reads. Each runs from pcs inside the window too, where
// the run starts with every older value equal to the newest, every pair
// labelled and as a captured image entered at those pcs.
//
// The Q programs read Q (MULq) at each depth behind a DIV, SQRT or RSQRT,
// which writes Q 7 pairs after it issues (RSQRT 13): in the issuing pair, at
// +1, +6 and +7, at RSQRT +12 and +13; a second DIV and a WAITQ land the
// pending Q first, and an E-bit end drains it. A branch over a pair into the
// window counts the pairs run, and a loop issues its DIV while the last
// iteration's is pending. Each runs from pcs inside the window too, every
// pair labelled and as a captured image entered at those pcs, so a label
// reached with Q pending and without both occur. Q, the pending Q and its
// wait must match.
//
// Last of all, the programs that wait for the EE (vu_programs.park_image):
// compiled for VU0 they park where the interpreter parks them, called
// directly and registered; compiled for VU1 they do not (the harness's park).
//
//   odin run tests/vu_micro -collection:ps=.
package main

import "core:fmt"
import "core:os"
import "core:strings"
import "ps:recomp/vu"
import "ps:tests/vu_programs"

DIR :: #directory
CASES_DIR :: DIR + "/cases"

main :: proc() {
	progs := vu_programs.programs()

	sb := strings.builder_make()
	fmt.sbprintln(&sb, "// Generated by tests/vu_micro: do not edit.\npackage main\n")
	fmt.sbprintln(&sb, "import \"core:fmt\"\nimport \"core:math\"\nimport \"core:math/rand\"\nimport \"core:os\"\nimport \"core:simd\"\nimport \"core:slice\"\nimport vu \"ps:ps2/vu\"\nimport \"ps:tests/vu_programs\"\n")
	fmt.sbprintln(&sb, "_ :: math\n_ :: simd\n_ :: slice\n")
	fmt.sbprintln(&sb, vu.VU_HELPERS)
	fmt.sbprintln(&sb, vu.MACRO_HELPERS)
	fmt.sbprintln(&sb, "Case :: struct {words: []u32, run: vu.Vu_Run, vu0: bool, pc: u32, leave, status: bool}\n")
	// Appended at run time: a literal this size warns of LLVM trouble.
	fmt.sbprintln(&sb, "CASES: [dynamic]Case\n\nadd_cases :: proc() {")
	for p, n in progs {
		status := vu_programs.status_reads(p.words) > 0
		for pc in p.pcs {fmt.sbprintfln(&sb, "\tappend(&CASES, Case{{code_%d[:], run_%d, %v, 0x%x, false, %v}})", n, n, p.unit == .VU0, pc, status)}
		for pc in p.leaves {fmt.sbprintfln(&sb, "\tappend(&CASES, Case{{code_%d[:], run_%d, %v, 0x%x, true, %v}})", n, n, p.unit == .VU0, pc, status)}
	}
	fmt.sbprintln(&sb, "}\n")
	elided: map[vu.Unit]string
	for p, n in progs {
		fmt.sbprintf(&sb, "code_%d := [?]u32{{", n)
		for w, k in p.words {fmt.sbprintf(&sb, "%s0x%08x", k == 0 ? "" : ", ", w)}
		fmt.sbprintln(&sb, "}\n")
		slow: map[string]int
		reads := vu_programs.status_reads(p.words)
		code := vu.emit_micro(n, p.words, p.unit, reads > 0, &slow, p.entries)
		fmt.sbprintln(&sb, code)
		for op, count in slow {if op != "pair" || count != reads {fail("program %d calls the interpreter for %s (%d)", n, op, count)}}
		if slow["pair"] != reads {fail("program %d leaves %d status reads of %d to the interpreter", n, slow["pair"], reads)}
		// The elision program, compiled with entries and then without: the
		// first must clamp fewer operands, behind fewer labels.
		if raw_data(p.words) != raw_data(vu_programs.ELIDE) {continue}
		if p.entries != nil {
			elided[p.unit] = code
			// Clamped once into a local: vf4 and vf10, and vf5 in the
			// branch pair. The delay slot's ADD reads vf4 after the MOVE
			// over it, so not from the local.
			for r in ([]int{4, 5, 10}) {
				local := fmt.tprintf("\tc%d_", r)
				if vu.VU_CLAMP_ELIDE && !strings.contains(code, local) {fail("program %d (%v) clamps vf%d into no local", n, p.unit, r)}
			}
			if strings.contains(code, "t := c4_") {fail("program %d (%v) reads vf4 from a stale local", n, p.unit)}
			continue
		}
		if !vu.VU_CLAMP_ELIDE {continue}
		e := elided[p.unit]
		if strings.count(e, "clamp4(vf[") >= strings.count(code, "clamp4(vf[") || strings.count(e, "case 0x") >= strings.count(code, "case 0x") {
			fail("program %d (%v) elides no clamp or label", n, p.unit)
		}
	}
	// The programs that wait for the EE (vu_programs.park_image), compiled
	// for each unit: only VU0's parks (the harness's park).
	for unit, k in ([]vu.Unit{.VU0, .VU1}) {
		slow: map[string]int
		fmt.sbprintln(&sb, vu.emit_micro(len(progs) + k, vu_programs.park_image(), unit, false, &slow))
		if len(slow) != 0 {fail("the park programs (%v) call the interpreter: %v", unit, slow)}
		fmt.sbprintfln(&sb, "PARK_VU%d :: run_%d\n", k, len(progs) + k)
	}
	fmt.sbprint(&sb, HARNESS)

	dir :: CASES_DIR
	if !os.exists(dir) {
		if err := os.make_directory(dir); err != nil {fail("mkdir %s: %v", dir, err)}
	}
	path :: CASES_DIR + "/main.odin"
	if err := os.write_entire_file(path, sb.buf[:]); err != nil {fail("write %s: %v", path, err)}
	unit_packages()

	// odin exits 0 on some build errors (an -out: without .exe on Windows), so a
	// missing binary afterwards fails the test. Remove any stale one first;
	// -keep-executable leaves the new one to check.
	out :: CASES_DIR + "/vu_micro_cases" + (".exe" when ODIN_OS == .Windows else "")
	_ = os.remove(out)
	p, err := os.process_start({command = {"odin", "run", dir, "-collection:ps=" + DIR + "/../..", "-out:" + out, "-keep-executable"}, stdout = os.stdout, stderr = os.stderr})
	if err != nil {fail("odin run: %v", err)}
	st, werr := os.process_wait(p)
	if werr != nil {fail("odin run: %v", werr)}
	if !st.success {fail("cases failed (exit %d)", st.exit_code)}
	if !os.exists(out) {fail("cases not built: %s", out)}
}

// The cases share one package and both units' helpers. Here each unit's
// code stands alone, under emit_head as generate writes it: a DIV, an RSQRT
// and a SQRT, whose I and D bits need div_bits, must check.
@(private = "file")
unit_packages :: proc() {
	words := []u32 {
		vu_programs.lower_sp(vu_programs.DIV, 0b0011, 1, 0), vu_programs.NOP_U,
		vu_programs.lower_sp(vu_programs.RSQRT, 0b1111, 1, 0), vu_programs.NOP_U,
		vu_programs.lower_sp(vu_programs.SQRT, 0b0100, 1, 0), vu_programs.NOP_U | vu_programs.E_BIT,
		vu_programs.NOP_L, vu_programs.NOP_U,
	}
	for unit in vu.Unit {
		sb := strings.builder_make()
		vu.emit_head(&sb, unit, "ps:ps2/vu")
		fmt.sbprintln(&sb, "_ :: math\n_ :: simd\n")
		slow: map[string]int
		fmt.sbprintln(&sb, vu.emit_micro(0, words, unit, false, &slow))
		if len(slow) != 0 {fail("%v DIV program calls the interpreter: %v", unit, slow)}
		dir := fmt.tprintf("%s/vu%d", CASES_DIR, int(unit))
		if !os.exists(dir) {
			if err := os.make_directory(dir); err != nil {fail("mkdir %s: %v", dir, err)}
		}
		path := fmt.tprintf("%s/code.odin", dir)
		if err := os.write_entire_file(path, sb.buf[:]); err != nil {fail("write %s: %v", path, err)}
		p, err := os.process_start({command = {"odin", "check", dir, "-no-entry-point", "-collection:ps=" + DIR + "/../.."}, stdout = os.stdout, stderr = os.stderr})
		if err != nil {fail("odin check: %v", err)}
		st, werr := os.process_wait(p)
		if werr != nil {fail("odin check: %v", werr)}
		if !st.success {fail("%v code alone does not check (exit %d)", unit, st.exit_code)}
	}
	fmt.println("ok vu_micro unit packages")
}

@(private = "file")
fail :: proc(what: string, args: ..any) -> ! {
	fmt.eprint("FAIL vu_micro: ")
	fmt.eprintfln(what, ..args)
	os.exit(1)
}

// The generated program's runner.
HARNESS :: `SEED :: 0x5eed_0b17
TRIALS :: 300

SPECIAL := [?]u32{0, 0x80000000, 0x7f800000, 0xff800000, 0x7fffffff, 0xffffffff, 0x7f7fffff, 0xff7fffff, 1, 0x3f800000, 0xbf800000, 0x00800000, 0x007fffff}

rnd :: proc() -> u32 {
	switch rand.uint32() % 3 {
	case 0: return SPECIAL[rand.uint32() % len(SPECIAL)]
	case 1: return transmute(u32)(rand.float32_range(-4, 4))
	}
	return rand.uint32()
}

main :: proc() {
	add_cases()
	rand.reset(SEED)
	vu.vu_init()
	fails, flagged, status_set, vu1_set := 0, 0, 0, 0
	for c, n in CASES {
		v := c.vu0 ? &vu.vu0 : &vu.vu1
		mem := ([^]u32)(raw_data(v.mem))[:len(v.mem) / 4]
		mem_init := make([]u32, len(mem))
		mem_want := make([]u32, len(mem))
		for &b in v.micro {b = 0}
		copy(([^]u32)(&v.micro[0])[:len(c.words)], c.words)
		for _ in 0 ..< TRIALS {
			init := v^
			init.vf[0].f = {0, 0, 0, 1}
			for k in 1 ..< 32 {for l in 0 ..< 4 {init.vf[k].u[l] = rnd()}}
			for l in 0 ..< 4 {init.acc.u[l] = rnd()}
			init.vi[0] = 0
			for k in 1 ..< 16 {init.vi[k] = u16(rand.uint32())}
			init.vi[2] = 0xffff
			init.i = transmute(f32)rnd()
			init.q = transmute(f32)rnd()
			init.q_next, init.q_wait = transmute(f32)rnd(), 0 // as a microprogram starts: no Q pending
			init.q_flags, init.q_due = rand.uint32() & 0x30, 0 // a stale DIV's bits, none due
			init.p_next, init.p_wait = transmute(f32)rnd(), 0 // nor P
			init.vih = {} // nor a pair run before it (the branch VI delay's history)
			init.p = transmute(f32)rnd()
			init.mac = rand.uint32() & 0xffff
			init.status = rand.uint32() & 0xfcf // I and D clear, so the control counts the program's
			// As a microprogram starts: every older flag the newest.
			init.old_mac, init.old_status, init.old_clip = init.mac, init.status, init.clip
			for &w in mem_init {w = rnd()}
			// A VU0 program reaches VU1's registers through its window.
			vu1_init := c.vu0 ? vu_programs.vu1_random(rnd) : vu.vu1
			if c.vu0 {vu.vu1 = vu1_init}
			v^ = init
			copy(mem, mem_init)
			want_exit := vu.Vu_Exit.End
			if c.leave { // to the interpreter at once
				v.tpc = c.pc
				want_exit = .Leave
			} else if c.vu0 {
				vu.vu0_call_micro(c.pc)
			} else {
				vu.vu1_start(c.pc)
			}
			want := v^
			vu1_want := vu.vu1
			copy(mem_want, mem)
			if c.vu0 {vu.vu1 = vu1_init}
			v^ = init
			copy(mem, mem_init)
			budget := 1000
			pc, exit := c.run(c.pc, &budget)
			// The end drains a pending Q and P, as vu0_exec and vu1_exec do after the run.
			if exit == .End {vu.vu_drain(v)}
			got := v^
			if want.mac != init.mac {flagged += 1}
			if c.vu0 && want.status & 0x30 != 0 {status_set += 1}
			if !c.vu0 && c.status && want.status & 0x30 != 0 {vu1_set += 1}
			same := exit == want_exit && pc == want.tpc && got.vi == want.vi && got.acc.u == want.acc.u && got.mac == want.mac
			same &&= transmute(u32)got.q == transmute(u32)want.q && transmute(u32)got.p == transmute(u32)want.p && slice.equal(mem, mem_want)
			same &&= transmute(u32)got.q_next == transmute(u32)want.q_next && got.q_wait == want.q_wait
			same &&= transmute(u32)got.p_next == transmute(u32)want.p_next && got.p_wait == want.p_wait
			same &&= got.q_flags == want.q_flags && got.q_due == want.q_due
			same &&= !(c.vu0 || c.status) || got.status == want.status
			for k in 0 ..< 32 {same &&= got.vf[k].u == want.vf[k].u}
			same &&= !c.vu0 || vu_programs.vu1_same(&vu.vu1, &vu1_want)
			if !same {
				fails += 1
				if fails < 10 {
					k := 0 // the first VF register that differs, else vf31
					for k < 31 && got.vf[k].u == want.vf[k].u {k += 1}
					fmt.eprintfln("FAIL vu_micro case %d (vu%d, from %04x): got exit %v pc %04x mac %04x status %04x vi1 %04x vf%d %08x, want pc %04x mac %04x status %04x vi1 %04x vf%d %08x; same Q %v, same P %v, same memory %v, same VU1 %v",
						n, c.vu0 ? 0 : 1, c.pc, exit, pc, got.mac, got.status, got.vi[1], k, got.vf[k].u, want.tpc, want.mac, want.status, want.vi[1], k, want.vf[k].u,
						transmute(u32)got.q == transmute(u32)want.q, transmute(u32)got.p == transmute(u32)want.p, slice.equal(mem, mem_want), !c.vu0 || vu_programs.vu1_same(&vu.vu1, &vu1_want))
				}
				break
			}
		}
	}
	// A VU1 program with no status read, registered alone, so compiled VU1
	// code does not compute status: its outside readers are compat rows.
	stale := -1
	for c, n in CASES {
		if !c.vu0 && !c.status && !c.leave {stale = n; break}
	}
	if stale < 0 {
		fmt.eprintln("FAIL vu_micro: no VU1 case without a status read")
		fails += 1
	} else {
		c := CASES[stale]
		vu.vu1_register_ranges({{0, c.words}}, c.run)
		if !vu_programs.stale_status(c.words, c.pc) {fails += 1}
	}
	fails += park()
	fmt.printfln("vu_micro: %d cases x %d trials, %d failing, MAC changed in %d, VU0 I or D set in %d, VU1 in %d", len(CASES), TRIALS, fails, flagged, status_set, vu1_set)
	// A VU0 case whose divisors never set I or D would not test the merge.
	if status_set < TRIALS * 3 {fmt.eprintfln("FAIL vu_micro: VU0 I or D set in only %d trials", status_set); os.exit(1)}
	if vu1_set < TRIALS * 3 {fmt.eprintfln("FAIL vu_micro: VU1 I or D set in only %d trials", vu1_set); os.exit(1)}
	if fails > 0 {os.exit(1)}
}

// A VU0 program that waits for the EE (vu_programs.park_image) parks in
// compiled code where the interpreter parks it: called directly it stops at
// the loop's first pair after one turn, with a Q pending only once it
// landed, and compiled for VU1 never; registered, the two loops park and a
// CTC2 that ends each lets the program go on to its end. The failures.
park :: proc() -> (fails: int) {
	bad :: proc(fails: ^int, what: string, args: ..any) {
		fmt.eprint("FAIL vu_micro park: ")
		fmt.eprintfln(what, ..args)
		fails^ += 1
	}
	start :: proc(v: ^vu.Vu) {
		for r in 1 ..< 32 {v.vf[r].f = {f32(r), f32(r) + 1, -f32(r), 0}}
		v.vi = 1
		v.vi[0] = 0
		v.q, v.q_next, v.q_wait, v.q_flags, v.q_due = 5, 0, 0, 0, 0
		v.p, v.p_next, v.p_wait = 0, 0, 0
		v.vih = {}
		v.mac, v.clip, v.status = 0xffff, 0, 0
		v.old_mac, v.old_status, v.old_clip = v.mac, v.status, v.clip
	}
	words := vu_programs.park_image()
	for v in ([]^vu.Vu{&vu.vu0, &vu.vu1}) {
		for &b in v.micro {b = 0}
		copy(([^]u32)(&v.micro[0])[:len(words)], words)
	}
	vu.vu0_micro_touch()
	vu.vu1_micro_touch()
	v := &vu.vu0

	start(v)
	budget := 1000
	pc, exit := PARK_VU0(0, &budget)
	if exit != .Park || pc != vu_programs.PARK_LOOP_1 || budget != 999 {
		bad(&fails, "a direct call into the first loop: exit %v, pc %04x, budget %d; want Park, %04x, 999", exit, pc, budget, vu_programs.PARK_LOOP_1)
	}
	budget = 1000
	pc, exit = PARK_VU0(vu_programs.PARK_LOOP_1, &budget)
	if exit != .Park || pc != vu_programs.PARK_LOOP_1 || budget != 999 {
		bad(&fails, "a direct call at the first loop: exit %v, pc %04x, budget %d; want Park, %04x, 999", exit, pc, budget, vu_programs.PARK_LOOP_1)
	}
	start(v)
	budget = 1000
	pc, exit = PARK_VU0(vu_programs.PARK_DIV, &budget)
	if exit != .Park || pc != vu_programs.PARK_DIV_LOOP || budget >= 999 || v.q_wait | v.p_wait | v.q_due != 0 || v.q != 2 {
		bad(&fails, "a direct call with a DIV before the loop: exit %v, pc %04x, budget %d, Q wait %d due %d, Q %v; want Park, %04x, under 999, 0 0, 2",
			exit, pc, budget, v.q_wait, v.q_due, v.q, vu_programs.PARK_DIV_LOOP)
	}
	start(v)
	v.vi[8] = 1
	budget = 1000
	pc, exit = PARK_VU0(vu_programs.PARK_LATE, &budget)
	if exit != .End || pc != vu_programs.PARK_LATE_END {
		bad(&fails, "a loop entered behind an integer write: exit %v, pc %04x; want End, %04x", exit, pc, vu_programs.PARK_LATE_END)
	}
	start(&vu.vu1)
	budget = 1000
	pc, exit = PARK_VU1(0, &budget)
	if exit != .Leave || budget > 0 {bad(&fails, "the first loop compiled for VU1: exit %v, pc %04x, budget %d; want Leave with no budget left", exit, pc, budget)}

	vu.vu0_register_ranges({{0, words}}, PARK_VU0)
	vu.vu0_micro_touch()
	start(v)
	vu.vu0_call_micro(0)
	if !vu.vu0_parked || v.tpc != vu_programs.PARK_LOOP_1 || v.old_mac == 0xffff {
		bad(&fails, "registered, the first loop: parked %v, tpc %04x, older MAC %04x; want true, %04x, the ADD's flags", vu.vu0_parked, v.tpc, v.old_mac, vu_programs.PARK_LOOP_1)
	}
	vu.vu0_ctrl_write(5, 9)
	if !vu.vu0_parked || v.tpc != vu_programs.PARK_LOOP_1 {bad(&fails, "registered, a CTC2 that does not end the loop: parked %v, tpc %04x", vu.vu0_parked, v.tpc)}
	vu.vu0_ctrl_write(1, 0)
	if !vu.vu0_parked || v.tpc != vu_programs.PARK_LOOP_2 || v.vi[3] != 7 {
		bad(&fails, "registered, the second loop: parked %v, tpc %04x, vi3 %d; want true, %04x, 7", vu.vu0_parked, v.tpc, v.vi[3], vu_programs.PARK_LOOP_2)
	}
	vu.vu0_ctrl_write(2, 0)
	if vu.vu0_parked || v.tpc != vu_programs.PARK_END || v.vi[4] != 9 {
		bad(&fails, "registered, the end: parked %v, tpc %04x, vi4 %d; want false, %04x, 9", vu.vu0_parked, v.tpc, v.vi[4], vu_programs.PARK_END)
	}
	return
}
`
