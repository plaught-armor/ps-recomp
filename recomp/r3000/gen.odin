// A PS1 program: a PS-X EXE and its overlays.
//
// Options:
//   exe              the PS-X EXE
//   out              output directory (exe.odin, ovl_NN/funcs.odin,
//                    overlays.odin)
//   runtime          import path of the psx runtime package, relative to out
//   code_lo, code_hi the executable's code range (hex); the rest is data
//   cycles_per_insn  average cost per instruction including memory stalls
//   package_insns    instructions per generated overlay package
//   overlays         optional: directory with manifest.tsv (file, slot)
//   funcs            optional: listed entries (space, entry); space is `ram`
//                    for the executable, else an overlay's file name less .bin
//   patches          optional: patch points (at, cond, target)
//   quiet            optional: `true` leaves out per-function warnings
//   native_arch      optional: also compile to machine code, for x64_sysv,
//                    x64_win or arm64 (psx/native.odin loads it)
//   native_out       with native_arch: the file the machine code goes to
//
// Every module is split with references from the whole program: overlays
// call each other and the executable through pointers.
package r3000

import "core:fmt"
import "core:slice"
import "core:strings"
import "../mips"
import "../native"

@(private = "file")
REC_HEADER :: "// Generated by ps-recomp. Do not edit."

// The runtime's packages generated code calls into (`cpu.lw`, `gte.gte_cmd`,
// `io.run_events`), each marked used so a file that needs none still builds.
@(private = "file")
RUNTIME_PACKAGES :: [?]string{"cpu", "gte", "io"}

@(private = "file")
runtime_imports :: proc(b: ^strings.Builder, runtime: string, depth: int) {
	rt := mips.import_path(runtime, depth)
	line(b, "import \"ps:core\"")
	for p in RUNTIME_PACKAGES {
		line(b, "import %s \"%s/%s\"", p, rt, p)
	}
	line(b, "\n_ :: core")
	for p in RUNTIME_PACKAGES {
		line(b, "_ :: %s", p)
	}
}

@(private = "file")
Overlay :: struct {
	name: string,
	img:  mips.Image,
}

@(private = "file")
Package :: struct {
	name: string,
	body: strings.Builder,
	rows: [dynamic]string,
	deps: map[string]struct{},
}

@(private = "file")
Program :: struct {
	exe:      mips.Image,
	overlays: []Overlay,
	listed:   map[string][dynamic]u32, // by space
	patches:  []Patch,
	refs:     Set,
	runtime:  string,
	cycles:   int,
	out:      string,
	quiet:    bool,
	code:     ^native.Asm, // nil without native_arch
	n_funcs:  [dynamic]native.Blob_Func,
	n_ovls:   [dynamic]native.Blob_Ovl,
}

generate :: proc(o: mips.Options) {
	p: Program
	p.exe = mips.load_psx_exe(mips.option(o, "exe"))
	p.out = mips.option(o, "out")
	p.runtime = mips.option(o, "runtime")
	p.cycles = mips.parse_int(mips.option(o, "cycles_per_insn"))
	p.quiet = mips.option_or(o, "quiet", "") == "true"
	if s := mips.option_or(o, "native_arch", ""); s != "" {
		arch, ok := native.parse_arch(s)
		if !ok {
			mips.fail("%s: unknown native_arch %s", o.path, s)
		}
		p.code = new(native.Asm)
		p.code^ = native.make_asm(arch, native_ram(), NATIVE_CACHED[:])
	}
	if dir := mips.option_or(o, "overlays", ""); dir != "" {
		t := mips.load_table(mips.join(dir, "manifest.tsv"), "file", "slot")
		ovls: [dynamic]Overlay
		for r in t.rows {
			file := mips.cell(t, r, "file")
			img := mips.Image {
				base = mips.parse_hex(mips.cell(t, r, "slot")),
				data = mips.read_file(mips.join(dir, file)),
			}
			append(&ovls, Overlay{strings.trim_suffix(file, ".bin"), img})
		}
		p.overlays = ovls[:]
	}
	if path := mips.option_or(o, "funcs", ""); path != "" {
		t := mips.load_table(path, "space", "entry")
		for r in t.rows {
			space := mips.cell(t, r, "space")
			list := p.listed[space]
			append(&list, mips.parse_hex(mips.cell(t, r, "entry")))
			p.listed[space] = list
		}
	}
	if path := mips.option_or(o, "patches", ""); path != "" {
		t := mips.load_table(path, "at", "cond", "target")
		patches: [dynamic]Patch
		for r in t.rows {
			at, target := mips.parse_hex(mips.cell(t, r, "at")), mips.parse_hex(mips.cell(t, r, "target"))
			append(&patches, Patch{at, mips.cell(t, r, "cond"), target})
		}
		p.patches = patches[:]
	}
	code_lo, code_hi := mips.parse_hex(mips.option(o, "code_lo")), mips.parse_hex(mips.option(o, "code_hi"))
	// References into any module's code: data words and lui pairs anywhere.
	lo, hi := code_lo, code_hi
	for ov in p.overlays {
		a, b := mips.image_range(ov.img)
		lo, hi = min(lo, a), max(hi, b)
	}
	program_refs(&p.refs, p.exe, lo, hi)
	for ov in p.overlays {
		program_refs(&p.refs, ov.img, lo, hi)
	}
	recomp_exe(&p, code_lo, code_hi)
	if p.overlays != nil {
		recomp_overlays(&p, mips.parse_int(mips.option(o, "package_insns")))
	}
	if p.code != nil {
		path := mips.option(o, "native_out")
		if !native.write_blob(path, p.code, p.n_funcs[:], p.n_ovls[:]) {
			mips.fail("cannot write %s", path)
		}
		fmt.printfln("native: %d bytes", len(p.code.code))
	}
}

@(private = "file")
program_refs :: proc(out: ^Set, img: mips.Image, lo, hi: u32) {
	mips.data_pointers(img, lo, hi, out)
	a, b := mips.image_range(img)
	mips.address_constants(RULES, img, a, b, lo, hi, out)
}

@(private = "file")
warn :: proc(p: ^Program, f: ^Func) {
	if p.quiet {
		return
	}
	for w in f.warnings {
		fmt.eprintfln("warning %s: %s", hexu(f.entry), w)
	}
}

// The executable into <out>/exe.odin.
@(private = "file")
recomp_exe :: proc(p: ^Program, code_lo, code_hi: u32) {
	img := p.exe
	ptrs: Set
	mips.data_pointers(img, code_lo, code_hi, &ptrs)
	// The EXE's entry point (pc0) is a certain entry, as no jal reaches it.
	known: Set
	known[img.entry] = {}
	entries, calls, guessed := mips.module_entries(RULES, img, code_lo, code_hi, p.listed["ram"][:], p.refs, known)
	funcs := mips.build_module(RULES, img, code_lo, code_hi, entries, ptrs, calls, p.refs, guessed)
	b := strings.builder_make()
	line(&b, "%s\npackage rec\n", REC_HEADER)
	runtime_imports(&b, p.runtime, 0)
	line(&b, "")
	names := make([]string, len(funcs))
	n := 0
	for f, k in funcs {
		names[k] = fmt.aprintf("f_%08x", f.entry)
		emit_func(f, &b, names[k], p.patches, p.cycles)
		if p.code != nil {
			append(&p.n_funcs, native.Blob_Func{f.entry, native_func(p.code, f, p.patches, p.cycles)})
		}
		warn(p, f)
		n += len(f.insns)
	}
	line(&b, "EXE_FUNCS := [?]cpu.Func_Entry{")
	for f, k in funcs {
		line(&b, "\t{{%s, %s}},", hexu(f.entry), names[k])
	}
	line(&b, "}")
	mips.make_dirs(p.out)
	mips.write_file(mips.join(p.out, "exe.odin"), b.buf[:])
	fmt.printfln("exe: %d functions, %d instructions", len(funcs), n)
}

// Every overlay into <out>/ovl_NN/funcs.odin, packages of about
// package_insns instructions each (separate LLVM modules build in
// parallel), and <out>/overlays.odin. Identical functions are emitted once.
@(private = "file")
recomp_overlays :: proc(p: ^Program, package_insns: int) {
	packages: [dynamic]^Package
	Emitted :: struct {
		pkg, name: string,
		off:       u32, // native code
	}
	emitted: map[string]Emitted
	cur: ^Package
	size := package_insns
	total := 0
	for o in p.overlays {
		img := o.img
		slot, hi := mips.image_range(img)
		ov_id, _ := mips.word(img, slot)
		ptrs: Set
		mips.data_pointers(img, slot, hi, &ptrs)
		// Code may follow a header of strings or tables; its first function
		// can be reached only through pointers built at run time. Header
		// data precedes it, so it skips the fall-through check.
		known: Set
		for a := slot + 4; a < hi; a += 4 {
			if mips.is_prologue(img, a) {
				known[mips.function_start(img, a, slot + 4)] = {}
				break
			}
		}
		entries, calls, guessed := mips.module_entries(RULES, img, slot + 4, hi, p.listed[o.name][:], p.refs, known)
		for k in known {
			calls[k] = {}
		}
		funcs := mips.build_module(RULES, img, slot + 4, hi, entries, ptrs, calls, p.refs, guessed)
		if size >= package_insns {
			cur = new(Package)
			cur.name = fmt.aprintf("ovl_%02d", len(packages))
			append(&packages, cur)
			size = 0
		}
		for f in funcs {
			key := mips.func_key(f)
			if key not_in emitted {
				emit_func(f, &cur.body, key, p.patches, p.cycles)
				warn(p, f)
				off: u32
				if p.code != nil {
					off = native_func(p.code, f, p.patches, p.cycles)
				}
				emitted[key] = {cur.name, key, off}
				size += len(f.insns)
				total += len(f.insns)
			}
			e := emitted[key]
			ref := e.name
			if e.pkg != cur.name {
				ref = fmt.aprintf("%s.%s", e.pkg, e.name)
				cur.deps[e.pkg] = {}
			}
			sig: [4]string
			words: [4]u32
			for &s, k in sig {
				w, _ := mips.word(img, f.entry + 4 * u32(k))
				s = hexu(w)
				words[k] = w
			}
			if p.code != nil {
				append(&p.n_ovls, native.Blob_Ovl{f.entry, slot, ov_id, words, e.off})
			}
			append(&cur.rows, fmt.aprintf("\t{{%s, %s, %s, {{%s}}, %s}},", hexu(f.entry), hexu(slot), hexu(ov_id), strings.join(sig[:], ", "), ref))
		}
	}
	for pkg in packages {
		dir := mips.join(p.out, pkg.name)
		mips.make_dirs(dir)
		b := strings.builder_make()
		line(&b, "%s\npackage %s\n", REC_HEADER, pkg.name)
		runtime_imports(&b, p.runtime, 1)
		deps := make([]string, len(pkg.deps))
		n := 0
		for d in pkg.deps {
			deps[n] = d
			n += 1
		}
		slice.sort(deps)
		for d in deps {
			line(&b, "import \"../%s\"", d)
		}
		if len(deps) > 0 {
			line(&b, "")
		}
		line(&b, "")
		strings.write_string(&b, strings.to_string(pkg.body))
		line(&b, "FUNCS := [?]cpu.Ovl_Entry{")
		for r in pkg.rows {
			line(&b, "%s", r)
		}
		line(&b, "}")
		mips.write_file(mips.join(dir, "funcs.odin"), b.buf[:])
	}
	mips.remove_stale_packages(p.out, "ovl_", "funcs.odin", REC_HEADER, len(packages))
	b := strings.builder_make()
	line(&b, "%s\npackage rec\n\nimport cpu \"%s/cpu\"", REC_HEADER, mips.import_path(p.runtime, 0))
	for pkg in packages {
		line(&b, "import \"%s\"", pkg.name)
	}
	line(&b, "\nregister_overlays :: proc() {")
	for pkg in packages {
		line(&b, "\tcpu.register_overlay_funcs(%s.FUNCS[:])", pkg.name)
	}
	line(&b, "}")
	mips.write_file(mips.join(p.out, "overlays.odin"), b.buf[:])
	fmt.printfln("overlays: %d packages, %d unique functions, %d instructions", len(packages), len(emitted), total)
}
