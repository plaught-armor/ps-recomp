// A PS2 program: an Emotion Engine ELF without symbols.
//
// Options:
//   exe              the ELF; with disc, its path on the disc, by default
//                    the one SYSTEM.CNF names
//   disc             optional: a disc image (a .cue sheet, or a
//                    single-track .bin or .iso) to read exe from
//   out              optional: output directory (pNN/code.odin,
//                    vu0/code.odin, vu1/code.odin, all.odin); without it no
//                    Odin source is written
//   runtime          import path of the ps2 runtime, relative to out; by
//                    default ps:ps2
//   cycles_per_insn  optional: EE cycles charged per instruction; by default
//                    CYCLES_PER_INSN
//   package_insns    optional: instructions per generated package; by
//                    default PACKAGE_INSNS
//   code_lo, code_hi optional: the code range (hex); by default .text, or
//                    in an ELF without one its executable sections
//   code_ranges      optional, in place of code_lo and code_hi: the path of
//                    a table of code ranges (lo, hi), ascending, for code
//                    split by data
//   quiet            optional: `true` leaves out per-function warnings
//   words            optional: instruction words to replace before analysis
//                    (at, word), a game's code patches; the ELF the port
//                    loads into RAM keeps the original words
//   native_arch      optional: also compile to machine code, for x64_sysv,
//                    x64_win or arm64 (ps2/native.odin loads it)
//   native_out       with native_arch: the file the machine code goes to
//   native_vu        with native_arch: "true" compiles the VU programs to
//                    machine code too (recomp/vu/native.odin)
//   vu1_capture      optional: a VU1_CAPTURE file (ps2/vu/capture.odin) of
//                    microcode loaded from data, to compile besides .vutext
//                    (a missing file, ENOENT, is a warning: that microcode
//                    runs in the interpreter)
//   vu0_capture      optional: a VU0_CAPTURE file, the same for VU0
//   vu_only          with native_arch: "true" compiles the VU programs
//                    alone, as native_vu does, to a blob with no EE
//                    function (the player's mid-run load, play/midload.odin)
//   vu_status        with native_vu or vu_only: "all" has VU1 code compute
//                    status even where no program reads it
//                    (recomp/vu native_programs status_all)
//
// Packages hold consecutive functions up to package_insns instructions so
// each compiles as its own module. Every package has a `register` proc
// filling the runtime's call table; `all.odin` (package rec) sizes the table
// to the code range and calls them all.
package r5900

import "core:encoding/endian"
import "core:fmt"
import "core:slice"
import "core:strings"
import "../mips"
import "../native"
import "../vu"

@(private = "file")
REC_HEADER :: "// Generated by ps-recomp. Do not edit."

// The defaults of cycles_per_insn and package_insns: the median of the PS2
// ports' values (both give 1 and 40000).
CYCLES_PER_INSN :: 1
PACKAGE_INSNS :: 40000

// The runtime's subsystem packages that recompiled code calls into, besides
// the top package (the interpreter).
@(private = "file")
RUNTIME_PACKAGES :: [?]string{"cpu", "kernel", "mem", "vu"}

// The front end's view of an instruction.
@(private = "file")
front :: proc(pc, w: u32) -> mips.Insn {
	i := decode(pc, w)
	return {pc = pc, w = w, target = i.target, kind = mips.Kind(i.kind), rs = i.rs, halt = i.op == .ERET}
}

RULES :: mips.Rules {
	decode    = front,
	lead      = .Loose,
	lui_reset = true,
}

// Overwrite instruction words in the image from a table (at, word).
@(private)
replace_words :: proc(img: ^mips.Image, path: string) {
	t := mips.load_table(path, "at", "word")
	for r in t.rows {
		at := mips.parse_hex(mips.cell(t, r, "at"))
		if _, ok := mips.word(img^, at); !ok {
			mips.fail("%s: %s is not a word of the image", path, mips.hexu(at))
		}
		endian.put_u32(img.data[at - img.base:], .Little, mips.parse_hex(mips.cell(t, r, "word")))
	}
}

// The code ranges, ascending: the rows (lo, hi) of the code_ranges file,
// or code_lo and code_hi, or the .text section, or without one the
// executable sections but .vutext (VU code); explicit unless sections.
@(private = "file")
code_ranges :: proc(o: mips.Options, img: mips.Image) -> (ranges: [][2]u32, explicit: bool) {
	list: [dynamic][2]u32
	exe := img.name
	if path := mips.option_or(o, "code_ranges", ""); path != "" {
		t := mips.load_table(path, "lo", "hi")
		for r in t.rows {
			append(&list, [2]u32{mips.parse_hex(mips.cell(t, r, "lo")), mips.parse_hex(mips.cell(t, r, "hi"))})
		}
	} else if code_lo := mips.option_or(o, "code_lo", ""); code_lo != "" {
		append(&list, [2]u32{mips.parse_hex(code_lo), mips.parse_hex(mips.option(o, "code_hi"))})
	} else if text := mips.find_section(img, ".text"); text != nil {
		append(&list, [2]u32{text.addr, text.addr + text.size})
		return list[:], false
	} else {
		for s in img.sections {
			if s.flags & mips.SHF_EXEC != 0 && s.data != nil && s.name != ".vutext" {
				append(&list, [2]u32{s.addr, s.addr + s.size})
			}
		}
		slice.sort_by(list[:], proc(a, b: [2]u32) -> bool {return a[0] < b[0]})
		for i in 1 ..< max(len(list), 1) {
			if list[i][0] < list[i - 1][1] {
				mips.fail("%s: executable sections overlap; give code_lo and code_hi", exe)
			}
		}
		if len(list) == 0 {
			mips.fail("%s: no .text or executable section; give code_lo and code_hi", exe)
		}
		return list[:], false
	}
	if len(list) == 0 {
		mips.fail("%s: no code ranges", exe)
	}
	prev := img.base
	for t in list {
		lo, hi := t[0], t[1]
		if lo >= hi || lo < prev || hi - img.base > u32(len(img.data)) {
			mips.fail("%s: code range %08x-%08x outside the image or out of order", exe, lo, hi)
		}
		prev = hi
	}
	return list[:], true
}

// The bytes of img in [a, b) as an image without sections.
@(private = "file")
data_image :: proc(img: mips.Image, a, b: u32) -> mips.Image {
	return {base = a, data = img.data[a - img.base:b - img.base]}
}

// Whether f holds a placeholder a module loader fills when it loads the
// module that exports the symbol: `jal 0` for a function import, or, when
// data is true, `lui r,0` (r not $zero) for the high half of a data import,
// whose low half is the offset of the addiu, load or store after it. A
// function with only data imports (a getter that loads one global) holds no
// `jal 0`, so the lui has to count. But `lui r,0` also builds small constants
// (VU microprogram addresses, low scratch addresses) in images that import
// nothing, so it counts only in an image where some function holds a `jal 0`.
@(private = "file")
holds_import :: proc(f: ^Func, data: bool) -> bool {
	for _, i in f.insns {
		if i.w == 0x0c000000 || data && i.w & 0xffe0ffff == 0x3c000000 && i.w >> 16 & 31 != 0 {
			return true
		}
	}
	return false
}

// Removes from funcs those a module loader rewrites at run time, and returns
// how many. They stay in the interpreter, which runs the words in RAM:
// compiled, they would keep the ELF's.
drop_imports :: proc(funcs: ^[dynamic]^Func, quiet: bool) -> int {
	imports := false
	for f in funcs {
		imports ||= holds_import(f, false)
	}
	if !imports {
		return 0
	}
	n := 0
	for f in funcs {
		if !holds_import(f, true) {
			funcs[n] = f
			n += 1
		} else if !quiet {
			fmt.printfln("%08x: import placeholder, left to the interpreter", f.entry)
		}
	}
	dropped := len(funcs) - n
	resize(funcs, n)
	return dropped
}

// A hooked address inside a function other than at its entry is refused:
// that function's own code reaches it by a branch or by running on, which
// no hook sees.
check_hooked :: proc(funcs: []^Func, hooked: mips.Set) {
	if len(hooked) == 0 {return}
	for f in funcs {
		for h in hooked {
			if h != f.entry && f.start <= h && h < f.end {
				mips.fail("hooked %08x is inside function %08x (only a function's entry can be hooked)", h, f.entry)
			}
		}
	}
}

// The functions of img in the options' code ranges, the labels found on the
// way (lui-built addresses and kept data pointers) and the ranges' span.
discover :: proc(o: mips.Options, img: mips.Image) -> (funcs: [dynamic]^Func, labels: mips.Set, lo, hi: u32) {
	ranges, explicit := code_ranges(o, img)
	lo, hi = ranges[0][0], ranges[len(ranges) - 1][1]
	// Code addresses in data and built by lui pairs in code.
	refs, ptrs, mixed: mips.Set
	runs: [dynamic]mips.Run
	pairs: [dynamic][2]u32
	calls: mips.Set
	for t in ranges {
		if explicit {
			// The image outside the ranges is data, whatever its sections say
			// (code and data can share one executable section).
			from := img.base
			for c in ranges {
				mips.data_pointers(data_image(img, from, c[0]), t[0], t[1], &ptrs, &pairs)
				from = c[1]
			}
			mips.data_pointers(data_image(img, from, img.base + u32(len(img.data))), t[0], t[1], &ptrs, &pairs)
		} else {
			mips.data_pointers(img, t[0], t[1], &ptrs, &pairs)
			mips.mixed_words(img, t[0], t[1], &mixed, &runs)
		}
		for c in ranges {
			mips.address_constants(RULES, img, c[0], c[1], t[0], t[1], &refs)
		}
		for e in mips.call_targets(img, t[0], t[1]) {
			calls[e] = {}
		}
	}
	// jal targets from any range are certain entries in theirs.
	known: mips.Set
	known[img.entry] = {}
	for e in calls {
		known[e] = {}
	}
	// Labels: every lui-built address (in a section that holds code and
	// data together, only those on code: drop_data_labels), and the data
	// pointers table_labels keeps; every reference can start a function.
	for a in refs {
		labels[a] = {}
	}
	for a in ptrs {
		refs[a] = {}
	}
	// Words of sections that hold code and data together: only those that
	// point at a function's start (a prologue, or the global loads before
	// one) count, as entries and never as labels. A code word that passes
	// this points at a function anyway.
	for a in mixed {
		if mips.starts_function(img, a) {
			refs[a] = {}
		}
	}
	for t in ranges {
		// Guessed entries stay entries, but build_module gets none of them:
		// dropping data after a return is gated on r3000 games only so far.
		entries, _, guessed := mips.module_entries(RULES, img, t[0], t[1], nil, refs, known)
		tables: mips.Set
		mips.table_labels(RULES, img, t[0], t[1], ptrs, pairs[:], entries, &tables)
		for a in tables {
			labels[a] = {}
		}
		// After table_labels, so a jump table's labels stay labels.
		mips.vtable_entries(RULES, img, t[0], t[1], runs[:], tables, &entries)
		// Explicit ranges hold no data. Without them, a section that holds
		// code and data together keeps only the labels on code.
		if !explicit {
			mips.drop_data_labels(RULES, img, t[0], t[1], entries, guessed, tables, &labels)
		}
		delete(guessed)
		append(&funcs, ..mips.build_module(RULES, img, t[0], t[1], entries, labels, calls, {}, {}))
	}
	return
}

generate :: proc(o: mips.Options) {
	img := mips.load_elf(o)
	// Before vu_only too: words may touch .vutext, whose programs a mid-run
	// load must find the same as the startup conversion's.
	if path := mips.option_or(o, "words", ""); path != "" {
		replace_words(&img, path)
	}
	if mips.option_or(o, "vu_only", "") == "true" {
		vu_only(o, img)
		return
	}
	out := mips.option_or(o, "out", "")
	runtime := mips.option_or(o, "runtime", "ps:ps2")
	cycles := mips.parse_int(mips.option_or(o, "cycles_per_insn", fmt.tprint(CYCLES_PER_INSN)))
	package_insns := mips.parse_int(mips.option_or(o, "package_insns", fmt.tprint(PACKAGE_INSNS)))
	funcs, labels, lo, hi := discover(o, img)
	n_imports := drop_imports(&funcs, mips.option_or(o, "quiet", "") == "true")
	hooked, hooks_hash := mips.read_mod_hooks(o)
	check_hooked(funcs[:], hooked)

	// Assign packages.
	pkg_of: map[u32]int
	groups: [dynamic][dynamic]^Func
	append(&groups, make([dynamic]^Func))
	size := 0
	for f in funcs {
		if size >= package_insns {
			append(&groups, make([dynamic]^Func))
			size = 0
		}
		append(&groups[len(groups) - 1], f)
		pkg_of[f.entry] = len(groups) - 1
		size += len(f.insns)
	}

	code: ^native.Asm
	n_funcs: [dynamic]native.Blob_Func
	if s := mips.option_or(o, "native_arch", ""); s != "" {
		arch, ok := native.parse_arch(s)
		if !ok {
			mips.fail("%s: unknown native_arch %s", o.path, s)
		}
		code = new(native.Asm)
		code^ = native_asm(arch)
		code.sigs = EE_SIGS[:]
		// The hooked set's hash, as an import slot the runtime has only with
		// that set's mods loaded: a blob for other mods (or none) is refused.
		// None without hooks, so the blob is as before. Not temp allocated:
		// the name lasts until write_blob, past the free_all per function.
		if hooks_hash != 0 {_ = native.imp(code, fmt.aprintf("mod_hooks:%016x", hooks_hash))}
	}

	// With coverage, native code for x64 and arm64 both: the one native_out
	// gets in code, the other into a throwaway Asm, counted only (and
	// wasm32's, when that is native_out's).
	cover := mips.option_or(o, "coverage", "") == "true"
	asms: [3]^native.Asm // x64, arm64, wasm32
	if code != nil {
		switch code.arch {
		case .X64_SysV, .X64_Win: asms[0] = code
		case .Arm64: asms[1] = code
		case .Wasm32: asms[2] = code
		}
	}
	if cover {
		for &a, k in asms[:2] {
			if a == nil {
				a = new(native.Asm)
				a^ = native_asm(k == 0 ? .X64_SysV : .Arm64)
			}
		}
	}

	// Per Asm, a label for each function's entry, for direct calls. None
	// for a hooked function: calls to it (and jumps to it from another
	// function, which lower makes calls) go through cpu.call, where the
	// runtime puts the hook.
	entry_labels: [3]map[u32]native.Label
	for a, x in asms {
		if a == nil {continue}
		for f in funcs {
			if f.entry not_in hooked {entry_labels[x][f.entry] = native.new_label(a)}
		}
	}

	// Per backend, the sites that call the interpreter.
	slow_emit: map[string]int
	slow_vu: [vu.Unit]map[string]int
	slow_native: [3]map[string]int
	if out != "" {
		mips.make_dirs(out)
	}
	for g, n in groups {
		e := Emitter {
			refs   = &labels,
			pkg_of = &pkg_of,
			hooked = &hooked,
			pkg    = n,
			cycles = cycles,
			quiet  = mips.option_or(o, "quiet", "") == "true",
			slow   = &slow_emit,
		}
		strings.builder_init(&e.sb)
		sb := &e.sb
		fmt.sbprintln(sb, REC_HEADER)
		fmt.sbprintfln(sb, "package p%02d\n", n)
		fmt.sbprintln(sb, "import \"base:intrinsics\"")
		fmt.sbprintln(sb, "import \"core:math\"")
		fmt.sbprintln(sb, "import \"core:simd\"")
		rt := mips.import_path(runtime, 1)
		fmt.sbprintfln(sb, "import ps2 \"%s\"", rt)
		for p in RUNTIME_PACKAGES {
			fmt.sbprintfln(sb, "import %s \"%s/%s\"", p, rt, p)
		}
		fmt.sbprintln(sb, "\n_ :: intrinsics")
		fmt.sbprintln(sb, "_ :: ps2")
		for p in RUNTIME_PACKAGES {
			fmt.sbprintfln(sb, "_ :: %s", p)
		}
		fmt.sbprintln(sb, "")
		fmt.sbprintln(sb, FAST_HELPERS)
		fmt.sbprintln(sb, vu.VU_HELPERS) // for the VU0 macro instructions
		fmt.sbprintln(sb, vu.MACRO_HELPERS)
		fmt.sbprintln(sb, "register :: proc() {")
		// The hooked set built for (none: nothing, the source as before).
		if n == 0 && hooks_hash != 0 {fmt.sbprintfln(sb, "\tcpu.mod_hooks_hash = 0x%016x", hooks_hash)}
		for f in g {
			fmt.sbprintfln(sb, "\tcpu.register(0x%08x, f_%08x)", f.entry, f.entry)
			for l in interior_entries(&e, f) {
				fmt.sbprintfln(sb, "\tcpu.register(0x%08x, proc() {{f_%08x_at(0x%08x)}})", l, f.entry, l)
			}
		}
		fmt.sbprintln(sb, "}\n")
		for f in g {
			emit_func(&e, f)
			for a, x in asms {
				if a == nil {continue}
				entries := interior_entries(&e, f)
				// nil: wasm32 leaves f to the interpreter.
				fs := native_func(a, f, entries, cycles, &slow_native[x], entry_labels[x])
				if a == code {append(&n_funcs, ..fs)}
			}
			free_all(context.temp_allocator)
		}
		if out != "" {
			dir := mips.join(out, fmt.tprintf("p%02d", n))
			mips.make_dirs(dir)
			mips.write_file(mips.join(dir, "code.odin"), sb.buf[:])
		}
		strings.builder_destroy(sb)
	}
	if n_imports > 0 {
		fmt.printfln("%d functions with import placeholders left to the interpreter", n_imports)
	}
	if out != "" {
		mips.remove_stale_packages(out, "p", "code.odin", REC_HEADER, len(groups))
		fmt.printfln("%d functions in %d packages -> %s", len(funcs), len(groups), out)
	} else {
		fmt.printfln("%d functions", len(funcs))
	}
	if code != nil {
		path := mips.option(o, "native_out")
		// The VU microprograms too, with native_vu: the runtime runs them
		// natively once it knows them (ps2/vu).
		vus: [dynamic]native.Blob_Span
		if mips.option_or(o, "native_vu", "") == "true" {
			if code.arch == .Wasm32 {mips.fail("%s: no wasm32 VU backend yet", img.name)}
			native_vus(o, img, code, &vus)
		}
		code_size, ok := native.write_blob(path, code, n_funcs[:], nil, vus[:])
		if !ok {
			mips.fail("cannot write %s", path)
		}
		fmt.printfln("native: %d bytes -> %s", code_size, path)
		if code.arch == .Wasm32 {wasm_report(code.wa.stats, n_funcs[:])}
	}
	// The VU microprograms only as Odin source; without it they run in the
	// interpreter.
	programs: [vu.Unit]int
	for unit in vu.Unit {
		if out == "" {break}
		ok: bool
		programs[unit], ok = vu.generate(img, out, runtime, vu_capture(o, unit), unit, &slow_vu[unit])
		if !ok {
			mips.fail("%s: bad .vutext or %v capture", img.name, unit)
		}
	}
	if cover {
		coverage("emit", slow_emit)
		coverage("native x64", slow_native[0])
		coverage("native arm64", slow_native[1])
		if asms[2] != nil {coverage("native wasm32", slow_native[2])}
		if programs[.VU0] > 0 {coverage("vu0", slow_vu[.VU0])}
		coverage("vu", slow_vu[.VU1])
	}

	if out == "" {
		return
	}
	sb := strings.builder_make()
	fmt.sbprintln(&sb, REC_HEADER)
	fmt.sbprintln(&sb, "package rec\n")
	fmt.sbprintfln(&sb, "import cpu \"%s/cpu\"", mips.import_path(runtime, 0))
	for _, n in groups {
		fmt.sbprintfln(&sb, "import \"p%02d\"", n)
	}
	for n, unit in programs {
		if n > 0 {fmt.sbprintfln(&sb, "import \"vu%d\"", int(unit))}
	}
	fmt.sbprintln(&sb, "\nregister_all :: proc() {")
	fmt.sbprintfln(&sb, "\tcpu.text_range(0x%08x, 0x%08x)", lo, hi)
	for _, n in groups {
		fmt.sbprintfln(&sb, "\tp%02d.register()", n)
	}
	for n, unit in programs {
		if n > 0 {fmt.sbprintfln(&sb, "\tvu%d.register()", int(unit))}
	}
	fmt.sbprintln(&sb, "}")
	mips.write_file(mips.join(out, "all.odin"), sb.buf[:])
}

// The VU microprograms alone (vu_only), compiled for native_arch to a blob
// at native_out with no EE function: their microcode is the same in any
// set, and the EE code is left as it is.
@(private = "file")
vu_only :: proc(o: mips.Options, img: mips.Image) {
	arch, ok := native.parse_arch(mips.option(o, "native_arch"))
	if !ok {
		mips.fail("%s: unknown native_arch %s", o.path, mips.option(o, "native_arch"))
	}
	code := new(native.Asm)
	if arch == .Wasm32 {mips.fail("%s: no wasm32 VU backend yet", img.name)}
	code^ = native.make_asm(arch, native_ram())
	vus: [dynamic]native.Blob_Span
	native_vus(o, img, code, &vus)
	path := mips.option(o, "native_out")
	code_size, written := native.write_blob(path, code, nil, nil, vus[:])
	if !written {
		mips.fail("cannot write %s", path)
	}
	fmt.printfln("native: %d VU microprograms, %d bytes -> %s", len(vus), code_size, path)
}

// Both VUs' programs (.vutext and the captures) compiled into code, their
// spans appended to vus; vu_status "all" has VU1 code compute status.
@(private = "file")
native_vus :: proc(o: mips.Options, img: mips.Image, code: ^native.Asm, vus: ^[dynamic]native.Blob_Span) {
	status_all := mips.option_or(o, "vu_status", "") == "all"
	for unit in vu.Unit {
		if !vu.native_programs(code, img, vu_capture(o, unit), unit, vus, status_all) {
			mips.fail("%s: bad .vutext or %v capture", img.name, unit)
		}
	}
}

// The VU0_CAPTURE or VU1_CAPTURE file for unit, or "".
@(private = "file")
vu_capture :: proc(o: mips.Options, unit: vu.Unit) -> string {
	return mips.option_or(o, unit == .VU0 ? "vu0_capture" : "vu1_capture", "")
}

// The wasm32 module's largest functions, by the entry of each (its first
// in funcs), and the share of branches that go through a dispatch.
@(private = "file")
wasm_report :: proc(s: native.Wasm_Stats, funcs: []native.Blob_Func) {
	entry :: proc(funcs: []native.Blob_Func, fi: int) -> u32 {
		for f in funcs {if int(f.off) == fi {return f.addr}}
		return 0
	}
	via := 0.0 if s.branches == 0 else 100 * f64(s.via) / f64(s.branches)
	fmt.printfln("wasm32: %d functions; largest %d bytes (%08x); most dispatch arms %d (%08x); %d of %d branches through a dispatch (%.2f%%)", s.bodies, s.max_bytes, entry(funcs, s.max_func), s.max_arms, entry(funcs, s.arms_func), s.via, s.branches, via)
}

// Print the ops of one backend that call the interpreter, the most sites
// first.
@(private = "file")
coverage :: proc(backend: string, slow: map[string]int) {
	Row :: struct {
		op:    string,
		sites: int,
	}
	rows := make([dynamic]Row, 0, len(slow), context.temp_allocator)
	total := 0
	for k, v in slow {
		append(&rows, Row{k, v})
		total += v
	}
	slice.sort_by(rows[:], proc(a, b: Row) -> bool {return a.sites > b.sites || a.sites == b.sites && a.op < b.op})
	fmt.printfln("coverage %s: %d sites in %d ops call the interpreter", backend, total, len(rows))
	for r in rows {fmt.printfln("  %-24v %d", r.op, r.sites)}
}

// Copies of the hottest ps2 helpers, emitted into every code.odin. Each file
// compiles as its own module, so a call into ps2 is never inlined, not even a
// #force_inline one. These inline RAM and scratchpad accesses and leave
// everything else to the runtime.
FAST_HELPERS :: `sx32 :: #force_inline proc "contextless" (v: u32) -> u64 {return u64(i64(i32(v)))}

// cpu.mult, cpu.multu and cpu.madd: LO and HI of pipe unit = the low and
// high words of the product p, each sign-extended.
mulw :: #force_inline proc "contextless" (p: u64, unit: int) {
	cpu.state.lo.d[unit] = sx32(u32(p))
	cpu.state.hi.d[unit] = sx32(u32(p >> 32))
}

// cpu.div.
divw :: #force_inline proc "contextless" (a, b: u32, unit: int) {
	n, d := i32(a), i32(b)
	switch {
	case d == 0:
		cpu.state.lo.d[unit] = n < 0 ? 1 : ~u64(0)
		cpu.state.hi.d[unit] = sx32(a)
	case n == min(i32) && d == -1:
		cpu.state.lo.d[unit] = sx32(0x80000000)
		cpu.state.hi.d[unit] = 0
	case:
		cpu.state.lo.d[unit] = sx32(u32(n / d))
		cpu.state.hi.d[unit] = sx32(u32(n % d))
	}
}

// cpu.divu.
divuw :: #force_inline proc "contextless" (a, b: u32, unit: int) {
	if b == 0 {
		cpu.state.lo.d[unit] = ~u64(0)
		cpu.state.hi.d[unit] = sx32(a)
		return
	}
	cpu.state.lo.d[unit] = sx32(a / b)
	cpu.state.hi.d[unit] = sx32(a % b)
}

// cpu.plzcw's count for one word.
plzw :: #force_inline proc "contextless" (v: u32) -> u64 {
	v := v
	if v & 0x80000000 != 0 {v = ~v}
	return v == 0 ? 31 : u64(intrinsics.count_leading_zeros(v)) - 1
}

// cpu.fcond: set or clear the FPU condition bit.
fcond :: #force_inline proc "contextless" (t: bool) {
	if t {cpu.state.fcr31 |= cpu.FCR31_C} else {cpu.state.fcr31 &~= cpu.FCR31_C}
}

// cpu.fpu_add, cpu.fpu_sub, cpu.fpu_wide, cpu.fpu_mul, cpu.fpu_div,
// cpu.fpu_sqrt and cpu.fkey.
fspecial :: #force_inline proc "contextless" (x: f32) -> bool {
	t := transmute(u32)x & 0x7fffffff
	return t != 0 && t - 0x00800000 >= 0x7f000000
}

fwide :: #force_inline proc "contextless" (ua, ub: u32) -> f32 {
	ha := ua & 0x7f800000 >= 0x01000000 ? ua - 0x00800000 : ua & 0x80000000
	hb := ub & 0x7f800000 >= 0x01000000 ? ub - 0x00800000 : ub & 0x80000000
	h := transmute(u32)(transmute(f32)ha + transmute(f32)hb)
	switch h & 0x7f800000 {
	case 0:          return transmute(f32)h
	case 0x7f800000: return transmute(f32)(h | cpu.FMAX)
	}
	return transmute(f32)(h + 0x00800000)
}

fadd :: #force_inline proc "contextless" (a, b: f32) -> f32 {
	r := a + b
	if !(fspecial(a) | fspecial(b) | fspecial(r)) {return r}
	ua, ub := transmute(u32)a, transmute(u32)b
	if max(ua & 0x7f800000, ub & 0x7f800000, transmute(u32)r & 0x7f800000) == 0x7f800000 {return fwide(ua, ub)}
	return cpu.fpu_slow(.Add, a, b)
}

fsub :: #force_inline proc "contextless" (a, b: f32) -> f32 {
	r := a - b
	if !(fspecial(a) | fspecial(b) | fspecial(r)) {return r}
	ua, ub := transmute(u32)a, transmute(u32)b
	if max(ua & 0x7f800000, ub & 0x7f800000, transmute(u32)r & 0x7f800000) == 0x7f800000 {return fwide(ua, ub ~ 0x80000000)}
	return cpu.fpu_slow(.Sub, a, b)
}

fmul :: #force_inline proc "contextless" (a, b: f32) -> f32 {
	r := a * b
	if !(fspecial(a) | fspecial(b) | fspecial(r)) {return r}
	ua, ub := transmute(u32)a, transmute(u32)b
	sign := (ua ~ ub) & 0x80000000
	ea, eb := ua & 0x7f800000, ub & 0x7f800000
	if ea == 0 || eb == 0 || transmute(u32)r & 0x7f800000 == 0 {return transmute(f32)sign}
	if eb == 0x7f800000 {ua, ub = ub, ua}
	// The product is near 2^128 or more, so a is 1 or more and a / 2 a
	// host float.
	h := transmute(u32)(transmute(f32)(ua - 0x00800000) * transmute(f32)ub)
	return transmute(f32)(h & 0x7f800000 == 0x7f800000 ? sign | cpu.FMAX : h + 0x00800000)
}

// cpu.fpu_div. Not fdiv: vu.VU_HELPERS has one.
fpdiv :: #force_inline proc "contextless" (a, b: f32) -> f32 {
	ua, ub := transmute(u32)a, transmute(u32)b
	if ub & 0x7f800000 == 0 {return transmute(f32)(((ua ~ ub) & 0x80000000) | cpu.FMAX)}
	r := a / b
	return fspecial(a) | fspecial(b) | fspecial(r) ? cpu.fpu_slow(.Div, a, b) : r
}

// cpu.fpu_rsqrt. Not frsqrt: vu.VU_HELPERS has one.
fprsqrt :: #force_inline proc "contextless" (a, b: f32) -> f32 {
	if transmute(u32)b & 0x7f800000 == 0 {
		return transmute(f32)((transmute(u32)a & 0x80000000) | cpu.FMAX)
	}
	return fpdiv(a, fsqrt(b))
}

// cpu.cvt_w.
fcvtw :: #force_inline proc "contextless" (x: f32) -> i32 {
	u := transmute(u32)x
	if u & 0x7f800000 >= 0x4f000000 { // |x| >= 2^31
		return u & 0x80000000 != 0 ? min(i32) : max(i32)
	}
	return i32(x)
}

// The host root of a normal float is the f64 one rounded, as 53 >= 2 * 24 + 2.
fsqrt :: #force_inline proc "contextless" (x: f32) -> f32 {
	u := transmute(u32)x & 0x7fffffff
	switch u & 0x7f800000 {
	case 0:          return 0
	case 0x7f800000: return transmute(f32)(transmute(u32)math.sqrt(transmute(f32)(u - 0x01000000)) + 0x00800000)
	}
	return math.sqrt(transmute(f32)u)
}

fkey :: #force_inline proc "contextless" (x: f32) -> i32 {
	u := transmute(u32)x
	if u & 0x7f800000 == 0 {return 0}
	m := i32(u & 0x7fffffff)
	return u & 0x80000000 != 0 ? -m : m
}

// Host pointer for a plain RAM or scratchpad address, else nil.
// The scratchpad index skips the bounds check: the test before it keeps the
// start in range. A wide access is not checked past its first byte, and
// never was. Recompiled code raises no address error on a misaligned
// access; it assumes the guest keeps rd32/rd64 aligned, as the EE faults on
// a misaligned load or store. rd128/wr128 mask the address to 16 bytes.
@(private)
fast :: #force_inline proc "contextless" (a: u32) -> rawptr #no_bounds_check {
	if a < mem.fast_lim {return &mem.ram_base[a]}
	if a - mem.SPR_BASE < mem.SPR_SIZE {return &mem.spr[a - mem.SPR_BASE]}
	return nil
}

rd8 :: #force_inline proc(a: u32) -> u8 {p := fast(a); return p != nil ? (^u8)(p)^ : mem.rd8(a)}
rd16 :: #force_inline proc(a: u32) -> u16 {p := fast(a); return p != nil ? intrinsics.unaligned_load((^u16)(p)) : mem.rd16(a)}
rd32 :: #force_inline proc(a: u32) -> u32 {p := fast(a); return p != nil ? intrinsics.unaligned_load((^u32)(p)) : mem.rd32(a)}
rd64 :: #force_inline proc(a: u32) -> u64 {p := fast(a); return p != nil ? intrinsics.unaligned_load((^u64)(p)) : mem.rd64(a)}
rd128 :: #force_inline proc(a: u32) -> u128 {p := fast(a &~ 15); return p != nil ? intrinsics.unaligned_load((^u128)(p)) : mem.rd128(a)}

wr8 :: #force_inline proc(a: u32, v: u8) {if p := fast(a); p != nil {(^u8)(p)^ = v} else {mem.wr8(a, v)}}
wr16 :: #force_inline proc(a: u32, v: u16) {if p := fast(a); p != nil {intrinsics.unaligned_store((^u16)(p), v)} else {mem.wr16(a, v)}}
wr32 :: #force_inline proc(a: u32, v: u32) {if p := fast(a); p != nil {intrinsics.unaligned_store((^u32)(p), v)} else {mem.wr32(a, v)}}
wr64 :: #force_inline proc(a: u32, v: u64) {if p := fast(a); p != nil {intrinsics.unaligned_store((^u64)(p), v)} else {mem.wr64(a, v)}}
wr128 :: #force_inline proc(a: u32, v: u128) {if p := fast(a &~ 15); p != nil {intrinsics.unaligned_store((^u128)(p), v)} else {mem.wr128(a, v)}}

// mem.LWL, LWR, SWL, SWR, LDL, LDR, SDL and SDR over the aligned word or
// doubleword, I/O through rd32, rd64, wr32 and wr64 as the others.
lwl :: #force_inline proc(a: u32, rt: u64) -> u64 {
	s := a & 3
	return sx32((u32(rt) & (0x00ffffff >> (s * 8))) | (rd32(a &~ 3) << (24 - s * 8)))
}

lwr :: #force_inline proc(a: u32, rt: u64) -> u64 {
	s := a & 3
	m := rd32(a &~ 3)
	if s == 0 {return sx32(m)}
	return (rt & 0xffffffff_00000000) | u64((u32(rt) & (0xffffffff << (32 - s * 8))) | (m >> (s * 8)))
}

swl :: #force_inline proc(a: u32, rt: u64) {
	s := a & 3
	mask := s == 3 ? 0 : u32(0xffffff00) << (s * 8)
	wr32(a &~ 3, (rd32(a &~ 3) & mask) | (u32(rt) >> (24 - s * 8)))
}

swr :: #force_inline proc(a: u32, rt: u64) {
	s := a & 3
	mask := s == 0 ? 0 : u32(0xffffffff) >> (32 - s * 8)
	wr32(a &~ 3, (rd32(a &~ 3) & mask) | (u32(rt) << (s * 8)))
}

ldl :: #force_inline proc(a: u32, rt: u64) -> u64 {
	s := u64(a & 7)
	return (rt & (0x00ffffff_ffffffff >> (s * 8))) | (rd64(a &~ 7) << (56 - s * 8))
}

ldr :: #force_inline proc(a: u32, rt: u64) -> u64 {
	s := u64(a & 7)
	mask := s == 0 ? 0 : u64(0xffffffff_ffffffff) << (64 - s * 8)
	return (rt & mask) | (rd64(a &~ 7) >> (s * 8))
}

sdl :: #force_inline proc(a: u32, rt: u64) {
	s := u64(a & 7)
	mask := s == 7 ? 0 : u64(0xffffffff_ffffff00) << (s * 8)
	wr64(a &~ 7, (rd64(a &~ 7) & mask) | (rt >> (56 - s * 8)))
}

sdr :: #force_inline proc(a: u32, rt: u64) {
	s := u64(a & 7)
	mask := s == 0 ? 0 : u64(0xffffffff_ffffffff) >> (64 - s * 8)
	wr64(a &~ 7, (rd64(a &~ 7) & mask) | (rt << (s * 8)))
}
`
