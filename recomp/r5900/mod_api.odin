// The mod API of a PS2 program: `recomp --mod-api <options.tsv> <out dir>`
// writes <out dir>/mod_api.h and <out dir>/mod.ld (recomp/mips/mod_api.odin)
// for the boot program the options' exe (and disc) name. Its functions are
// the ones generate finds, in one space, `ram`, keyed slot 0 and the id
// the kernel gives the boot program (ps2/kernel exec_boot_program: the low
// word of the XXH3-64 of its ELF file). A function's signature is its first
// four words in the ELF as loaded, before the words option's patches,
// which the port's RAM does not have. It compiles nothing.
package r5900

import "core:fmt"
import "core:hash/xxhash"
import "../mips"

// The mod region as the console has it (ps2/mem/mod_ram.odin; tests/mod_api
// checks they agree): mods link at MOD_BASE, and an image ends at
// MOD_IMAGE_END at most, leaving the guard word and MOD_STACK.
// MOD_ORIGINAL, below the region, is mod_call_original's address.
MOD_API :: 1
MOD_BASE :: 0x0e00_0000
MOD_REGION :: 0x0100_0000
MOD_STACK :: 16 * 1024
MOD_IMAGE_END :: MOD_BASE + ((MOD_REGION - MOD_STACK - 4) &~ 15)
MOD_ORIGINAL :: MOD_BASE - 16

// The boot program's space and a row per function generate finds in it.
mod_api_load :: proc(o: mips.Options) -> (spaces: []mips.Mod_Api_Space, rows: []mips.Mod_Api_Row) {
	raw, _ := mips.read_exe(o)
	img := mips.load_elf(o)
	found := img
	if path := mips.option_or(o, "words", ""); path != "" {
		found.data = make([]u8, len(img.data))
		copy(found.data, img.data)
		replace_words(&found, path)
	}
	funcs, _, _, _ := discover(o, found)
	s := make([]mips.Mod_Api_Space, 1)
	s[0] = {"ram", img, 0, u32(xxhash.XXH3_64_default(raw))}
	r := make([]mips.Mod_Api_Row, len(funcs))
	for f, k in funcs {r[k] = {"ram", f.entry, ""}}
	return s, r
}

// Write the API of the program o names into out.
mod_api_write :: proc(o: mips.Options, out: string) {
	spaces, rows := mod_api_load(o)
	header, script, skips, err := mod_api(spaces, rows)
	if err != "" {
		mips.fail("%s: %s", o.path, err)
	}
	mips.mod_api_files(out, header, script)
	fmt.printfln("mod api: %d functions, %d not in the image, program %08x", len(rows), skips.outside, spaces[0].id)
}

// The header and linker script for rows (mips.mod_api).
mod_api :: proc(spaces: []mips.Mod_Api_Space, rows: []mips.Mod_Api_Row) -> (header, script: string, skips: mips.Mod_Api_Skips, err: string) {
	return mips.mod_api(TARGET, spaces, rows)
}

@(private = "file")
TARGET :: mips.Mod_Api_Target {
	top       = HEADER_TOP,
	tail      = HEADER_ORIGINAL,
	call      = "",
	version   = MOD_API,
	base      = MOD_BASE,
	image_end = MOD_IMAGE_END,
	original  = MOD_ORIGINAL,
}

@(private = "file")
HEADER_TOP :: `// A game's functions, for mods: generated by recomp --mod-api; do not edit.
//
// Build a mod against it with mods/build.sh, which builds for the console
// MOD_ARCH names. Each function is declared by name (<space>_<entry>) with
// unspecified arguments: cast it to the prototype you call it through.
// MOD_BEFORE, MOD_AFTER and MOD_REPLACE hook a function by that name.
//
// A mod runs from the mod region at MOD_BASE, in the 256 MiB segment the
// game's code is in, so a game function is a plain call (jal).
//
// Mods are built for the n32 ABI: integer and pointer arguments in a0-a7
// ($4-$11) and then on the stack, 64-bit registers, results in v0 and v1,
// as the game passes them. Floats are not: n32 gives each argument the
// register of its position (an int then a float: the float in $f13), the
// game's EABI counts float arguments apart from the integer ones (the
// float in $f12). So a mod must not hook or call a game function that
// takes a float argument or returns a float. Where it needs one, call it
// through a wrapper of the mod's own in assembly that takes the float's
// bits as an integer and moves them to the register the game expects.
#ifndef MOD_API_H
#define MOD_API_H

#define MOD_ARCH r5900
`

@(private = "file")
HEADER_ORIGINAL :: `
typedef unsigned long long u64;

// From a replacement: run the function it replaces, without its hooks, on
// the arguments now in a0-a7 and on the stack, and return its results.
// Cast it to the function's prototype, as a game function. It is the
// innermost running replacement's; a call from a before or after hook, or
// with no replacement running, is fatal.
unsigned mod_call_original();

// (int)f compiles to trunc.w.s, which the R5900 does not have (the build
// fails on it). mod_f2i converts with its cvt.w.s instead, which truncates
// toward zero and gives the largest int of f's sign for an f out of range.
static inline int mod_f2i(float f) {
	int i;
	__asm__("cvt.w.s %1, %1\n\tmfc1 %0, %1" : "=r"(i), "+f"(f));
	return i;
}
`
